# Copy this file to .env and replace every placeholder before starting the backend.
# Checkout transactions require a replica set (including for local MongoDB).
MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0
DB_NAME=anora

# Local HTTP development values. For production use HTTPS URLs and COOKIE_SECURE=true.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false

# Generate a unique random secret (at least 32 bytes) for each environment.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_BEFORE_RUNNING

# This account is created/synced by the seed process. Change both values before launch.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD

# Optional: needed for managed object storage. Without it, seed images are served locally.
EMERGENT_LLM_KEY=
APP_NAME=anora
INTEGRATION_PROXY_URL=
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Leave blank to disable online payments locally. Use Razorpay TEST keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# Leave EMAIL_BACKEND empty for automatic managed-email/log behavior.
# For local-only testing, select Mailpit; every recipient is redirected to the reserved .test address.
EMAIL_BACKEND=
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
EMAIL_FROM_ADDRESS=no-reply@anora.test
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=DRESSELLA
EMAIL_REPLY_TO=
